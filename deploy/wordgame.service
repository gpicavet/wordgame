[Unit]
Description=Wordgame server
After=network-online.target
Wants=network-online.target

[Service]
User=wordgame
WorkingDirectory=/opt/wordgame
Environment=WORDGAME_HOST=127.0.0.1
Environment=WORDGAME_PORT=8080
Environment=WORDGAME_DB=/var/lib/wordgame/wordgame.db
Environment=WORDGAME_DICT=/opt/wordgame/fr-libre.dawg
# Measured ~125 MB RSS under load with these limits (Stardust: 1 GB RAM).
ExecStart=/usr/bin/java -Xmx160m -Xss512k -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=48m -XX:+ExitOnOutOfMemoryError -jar /opt/wordgame/wordgame-server.jar
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/wordgame

[Install]
WantedBy=multi-user.target
